{
  "manifest_version": 3,
  "name": "Pretty-menu",
  "version": "1.0",
  "description": "Google homepage extension",
  "permissions": ["contextMenus", "storage", "tabs"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://lens.google.com/*",
    "https://www.lens.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}